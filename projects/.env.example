# Runtime
COZE_PROJECT_ENV=DEV
HOSTNAME=localhost
PORT=5000
DEPLOY_RUN_PORT=5000

# Supabase
# Use public/anonymous credentials only in COZE_SUPABASE_ANON_KEY.
# COZE_SUPABASE_SERVICE_ROLE_KEY is server-only and must never be exposed to the browser.
COZE_SUPABASE_URL=
COZE_SUPABASE_ANON_KEY=
COZE_SUPABASE_SERVICE_ROLE_KEY=

# The current LLMClient uses credentials supplied by the Coze runtime.
# There is intentionally no model API key placeholder until a standalone provider is implemented.
